generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CONSEILLER
  CLIENT
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  nom       String
  prenom    String
  role      Role     @default(CLIENT)
  client    Client?
  createdAt DateTime @default(now())
}

model Client {
  id              String           @id @default(cuid())
  raisonSociale   String
  formeJuridique  String?
  secteurActivite String?
  chiffreAffaires Float?
  telephone       String?
  adresse         String?
  ifu             String?
  userId          String           @unique
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  dossiers        Dossier[]
  ecritures       Ecriture[]
  demarches       Demarche[]
  journalDemarches JournalDemarche[]
  demandes        DemandeService[]
  contacts        DemandeContact[]
  createdAt       DateTime         @default(now())
}

// Creation d'entreprise : 5 etapes du stepper
enum EtapeDossier {
  INFORMATIONS
  FORME_JURIDIQUE
  PIECES
  DEPOT
  SUIVI
}

enum StatutDossier {
  EN_COURS
  DEPOSE
  TERMINE
  ABANDONNE
}

model Dossier {
  id             String        @id @default(cuid())
  denomination   String
  activite       String?
  formeJuridique String?
  capital        Float?
  siege          String?
  etape          EtapeDossier  @default(INFORMATIONS)
  statut         StatutDossier @default(EN_COURS)
  dateDepot      DateTime?
  numeroRccm     String?
  notes          String?       @db.Text
  clientId       String
  client         Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  pieces         Piece[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Piece {
  id        String   @id @default(cuid())
  nom       String
  chemin    String
  taille    Int
  type      String
  dossierId String
  dossier   Dossier  @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

// Comptabilite : ecritures au plan SYSCOHADA (compte = numero, classe = 1er chiffre)
model Ecriture {
  id       String   @id @default(cuid())
  date     DateTime
  journal  String
  piece    String?
  compte   String
  libelle  String
  debit    Decimal  @default(0) @db.Decimal(15, 2)
  credit   Decimal  @default(0) @db.Decimal(15, 2)
  clientId String
  client   Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, date])
  @@index([clientId, compte])
}

// Services : attestations et documents administratifs
enum TypeService {
  ATTESTATION_FISCALE
  ATTESTATION_CNSS
  CERTIFICAT_NON_FAILLITE
  ATTESTATION_DOMICILIATION_FISCALE
  QUITUS_FISCAL
  INVENTAIRE
  DECLARATION_IMPOTS
  PAIE_DECLARATIONS_SOCIALES
  FORMATION
  AUTRE
}

enum StatutDemande {
  NOUVELLE
  EN_COURS
  PRETE
  LIVREE
  REJETEE
}

model DemandeService {
  id          String        @id @default(cuid())
  type        TypeService
  description String?       @db.Text
  statut      StatutDemande @default(NOUVELLE)
  reponse     String?       @db.Text
  clientId    String
  client      Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

// Demandes envoyees depuis le site public (devis, inscription formation, message)
enum TypeContact {
  DEVIS
  FORMATION
  MESSAGE
}

enum StatutContact {
  NOUVEAU
  CONTACTE
  CONVERTI
  CLOS
}

model DemandeContact {
  id         String        @id @default(cuid())
  type       TypeContact
  nom        String
  entreprise String?
  email      String
  telephone  String?
  sujet      String?
  message    String?       @db.Text
  statut     StatutContact @default(NOUVEAU)
  note       String?       @db.Text
  // Rempli quand la demande vient d'un client connecte (devis, formation) ; vide pour un simple message
  clientId   String?
  client     Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([statut, createdAt])
  @@index([clientId])
}

// Contenu du site public modifiable depuis /gestion/site
// cle : "contact" | "services" ; valeur : JSON valide par l'API
model ReglageSite {
  cle       String   @id
  valeur    Json
  updatedAt DateTime @updatedAt
}

model LivreSite {
  id          String   @id @default(cuid())
  titre       String
  description String   @db.Text
  prix        Int?
  image       String
  alt         String
  visible     Boolean  @default(true)
  ordre       Int      @default(0)
  createdAt   DateTime @default(now())
}

// Registre des demarches faites pour un client sur les plateformes externes (e-MECeF, e-Services, Perfecto, MonEntreprise.bj)
enum PlateformeDemarche {
  E_MECEF
  E_SERVICES
  PERFECTO
  MONENTREPRISE
  AUTRE
}

enum StatutDemarche {
  A_FAIRE
  EN_COURS
  TERMINEE
}

model Demarche {
  id           String             @id @default(cuid())
  clientId     String
  client       Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  plateforme   PlateformeDemarche
  objet        String
  reference    String?
  montant      Decimal?           @db.Decimal(15, 2)
  statut       StatutDemarche     @default(A_FAIRE)
  dateDemarche DateTime           @default(now())
  note         String?            @db.Text
  createdAt    DateTime           @default(now())

  @@index([clientId, dateDemarche])
}

// Tracabilite : chaque creation, changement de statut et suppression d'une demarche, avec son auteur.
// Pas de cle etrangere vers Demarche : l'historique reste apres une suppression.
enum ActionDemarche {
  CREATION
  STATUT
  SUPPRESSION
}

model JournalDemarche {
  id         String         @id @default(cuid())
  demarcheId String
  clientId   String
  client     Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  action     ActionDemarche
  acteur     String
  acteurId   String?
  detail     String         @db.Text
  createdAt  DateTime       @default(now())

  @@index([clientId, createdAt])
  @@index([createdAt])
}
