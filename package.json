    "db:studio": "npm run prisma -- studio",
    "test": "node node_modules/tsx/dist/cli.mjs --test src/lib/compta.test.ts",
    "export:statique": "node scripts/export-statique.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@hookform/resolvers": "^5.9.2",
    "@prisma/client": "^6.19.3",
