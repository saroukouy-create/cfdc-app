    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.61.0",
    "next": "15.5.28",
    "next-auth": "^4.24.15",
    "papaparse": "^5.7.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.90.0",
    "recharts": "^3.10.1",
    "shadcn": "^4.22.1",
